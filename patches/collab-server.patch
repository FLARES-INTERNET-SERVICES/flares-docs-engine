+/**
+ * Capability tokens for room initialisation.
+ *
+ * `POST /api/rooms/:id/seed` decides what every future participant will
+ * open. Shipped, it took no credential at all — the reasoning in the
+ * route comment was that only the owner knows the freshly-minted room
+ * id, so the misuse window is theoretical.
+ *
+ * That holds for the instant after creation and stops holding
+ * immediately afterwards: room ids travel in share links, chat
+ * messages, browser history and access logs, and `/api/rooms` will list
+ * them. Anyone who reads one could replace the document every peer is
+ * about to load — silently, because the editor shows whatever the room
+ * says. For a school deployment that is the difference between "someone
+ * saw the essay" and "someone replaced the essay".
+ *
+ * So initialisation gets a real capability token: signed, short-lived,
+ * bound to one room and one operation, and accepted once.
+ *
+ * Deliberately separate from `auth/jwt.ts`'s `AccessClaims`, which is
+ * WOPI-shaped (sub / file_id / role) and carries permissions this
+ * operation has no use for. A capability token should say exactly one
+ * thing.
+ */
+import jwt from 'jsonwebtoken';
+
+/** The only operation these tokens authorise. */
+export const SEED_OPERATION = 'initialize_room' as const;
+
+const ALG = 'HS256';
+
+/** Default lifetime. Seeding happens seconds after room creation; a
+ *  short window bounds replay if a link leaks. */
+const DEFAULT_TTL_SECONDS = 300;
+
+export interface SeedClaims {
+  /** Room this token may seed, and only this room. */
+  room: string;
+  /** Capability, checked explicitly so a general-purpose token minted
+   *  elsewhere can never satisfy a seed request by accident. */
+  op: typeof SEED_OPERATION;
+  /** Belt and braces alongside `op` — an explicit grant reads clearly
+   *  at the call site and in logs. */
+  can_seed: true;
+  iat?: number;
+  exp?: number;
+}
+
+export class SeedTokenError extends Error {
+  constructor(
+    message: string,
+    /** Machine-readable reason. Logged server-side; NOT returned to the
+     *  caller, who gets one undifferentiated 401 — distinguishing
+     *  "expired" from "wrong room" is free reconnaissance. */
+    public readonly reason: string
+  ) {
+    super(message);
+    this.name = 'SeedTokenError';
+  }
+}
+
+function secret(): string | null {
+  const s = process.env.CASUAL_JWT_SECRET;
+  return typeof s === 'string' && s.length >= 16 ? s : null;
+}
+
+/**
+ * True when the deployment can enforce seed authentication.
+ *
+ * With no secret configured there is nothing to sign with. Rather than
+ * fail closed and break anonymous self-hosted deployments that never
+ * opted into auth, the route falls back to shipped behaviour and logs a
+ * warning once at boot. Deployments that care set CASUAL_JWT_SECRET —
+ * which the Flares lab does.
+ */
+export function isSeedAuthEnabled(): boolean {
+  return secret() !== null;
+}
+
+/** Mint a token authorising exactly one room's initialisation. */
+export function signSeedToken(room: string, ttlSeconds = DEFAULT_TTL_SECONDS): string {
+  const key = secret();
+  if (!key) throw new SeedTokenError('CASUAL_JWT_SECRET unset', 'not_configured');
+  const claims: SeedClaims = { room, op: SEED_OPERATION, can_seed: true };
+  return jwt.sign(claims, key, { algorithm: ALG, expiresIn: ttlSeconds });
+}
+
+/**
+ * Verify a token against the room it is being used on.
+ *
+ * Throws `SeedTokenError` on: missing/garbled token, bad signature,
+ * wrong algorithm, expiry, a token minted for a different room, or one
+ * carrying a different capability. `algorithms: [ALG]` is what stops an
+ * attacker re-signing the payload with `alg: none`.
+ */
+export function verifySeedToken(token: string | null | undefined, room: string): SeedClaims {
+  const key = secret();
+  if (!key) throw new SeedTokenError('CASUAL_JWT_SECRET unset', 'not_configured');
+  if (!token) throw new SeedTokenError('no seed token supplied', 'missing');
+
+  let payload: SeedClaims;
+  try {
+    payload = jwt.verify(token, key, { algorithms: [ALG] }) as SeedClaims;
+  } catch (err) {
+    const reason = err instanceof jwt.TokenExpiredError ? 'expired' : 'bad_signature';
+    throw new SeedTokenError(`seed token rejected: ${(err as Error).message}`, reason);
+  }
+
+  if (!payload || typeof payload !== 'object') {
+    throw new SeedTokenError('seed token payload not an object', 'malformed');
+  }
+  // Room binding. Without this a token for a room you own would seed
+  // any room whose id you can guess or read.
+  if (payload.room !== room) {
+    throw new SeedTokenError('seed token is for a different room', 'wrong_room');
+  }
+  if (payload.op !== SEED_OPERATION || payload.can_seed !== true) {
+    throw new SeedTokenError('token does not carry the seed capability', 'wrong_operation');
+  }
+  return payload;
+}
+
+/** Pull a seed token off a request: `x-seed-token` header, then
+ *  `?seed_token=`. Header preferred — it stays out of access logs. */
+export function extractSeedToken(req: {
+  headers: Record<string, unknown>;
+  query?: unknown;
+}): string | null {
+  const header = req.headers['x-seed-token'];
+  if (typeof header === 'string' && header.length > 0) return header;
+  const q = req.query as { seed_token?: unknown } | undefined;
+  if (q && typeof q.seed_token === 'string' && q.seed_token.length > 0) return q.seed_token;
+  return null;
+}
